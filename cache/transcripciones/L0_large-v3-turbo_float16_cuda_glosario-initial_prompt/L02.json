  },
  {
   "inicio": 96.89,
   "fin": 97.95,
   "texto": "Forma de pago"
  },
  {
   "inicio": 99.23,
   "fin": 102.35,
   "texto": "Tarjeta, ¿el motorizado lleva POS?"
  },
  {
   "inicio": 104.15,
   "fin": 107.53,
   "texto": "Sí, lleva POS, entonces le confirmo"
  },
  {
   "inicio": 107.53,
   "fin": 111.59,
   "texto": "Un arroz con mariscos, fuente, dos chicharrones de pescado personal"
  },
  {
   "inicio": 111.59,
   "fin": 115.87,
   "texto": "Y un Inca Kola de litro y medio con el descuento de 10 soles"
