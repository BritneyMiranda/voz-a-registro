 "segmentos": [
  {
   "inicio": 0.11,
   "fin": 4.51,
   "texto": "Cevichería La Ola, buenas tardes, le saluda a Milagros, ¿en qué le puedo ayudar?"
  },
  {
   "inicio": 5.59,
   "fin": 9.89,
   "texto": "Hola, buenas tardes, quería hacer un pedido para que me lo traigan"
  },
  {
   "inicio": 9.89,
   "fin": 13.39,
   "texto": "Claro que sí, dígame"
  },
  {
   "inicio": 14.77,
   "fin": 18.23,
   "texto": "Ya, primero un ceviche fuente para compartir"
  },
  {
   "inicio": 19.57,
   "fin": 22.29,
   "texto": "Un ceviche clásico, fuente"
  },
  {
   "inicio": 22.29,
   "fin": 28.83,
   "texto": "Ah, no, no, perdón, mejor cámbialo, que sea un arroz con mariscos, fuente"
  },
  {
   "inicio": 28.83,
   "fin": 30.93,
   "texto": "Ceviche comimos ayer"
  },
  {
   "inicio": 32.35,
   "fin": 37.11,
   "texto": "No se preocupe, entonces, un arroz con mariscos, fuente, ¿qué más?"
  },
  {
   "inicio": 38.05,
   "fin": 41.13,
   "texto": "Dos chicharrones de pescado personales"
  },
  {
   "inicio": 43.03,
   "fin": 46.51,
   "texto": "Dos chicharrones de pescado personales, ¿algo de tomar?"
  },
  {
   "inicio": 47.29,
   "fin": 51.71,
   "texto": "Una Inca Kola de litro y medio, ¿y cuánto me sale todo eso?"
  },
  {
   "inicio": 52.79,
   "fin": 61.85,
   "texto": "Le detallo, el arroz con mariscos, fuente, está 56, cada chicharrón 29 y la Inca Kola 10 soles"
  },
  {
   "inicio": 61.85,
   "fin": 66.21,
   "texto": "Como su pedido pasa de 100 soles, le aplicamos el descuento de 10 soles"
  },
  {
   "inicio": 66.21,
   "fin": 76.7,
   "texto": "¿La dirección de entrega?"
  },
  {
   "inicio": 79.72,
   "fin": 84.42,
   "texto": "Avenida Brasil 2875, en Pueblo Libre"
  },
  {
   "inicio": 84.42,
   "fin": 89.2,
   "texto": "Es una casa con puerta negra, hay que tocar el timbre de arriba"
  },
  {
