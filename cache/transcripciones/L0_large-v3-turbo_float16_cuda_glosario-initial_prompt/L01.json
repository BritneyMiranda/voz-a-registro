 "segmentos": [
  {
   "inicio": 4.23,
   "fin": 9.33,
   "texto": "Cevichería La Ola, buenas noches, le habla Kevin, ¿es para delivery o para recoger?"
  },
  {
   "inicio": 10.47,
   "fin": 13.25,
   "texto": "Hola, buenas noches, para delivery, por favor"
  },
  {
   "inicio": 14.59,
   "fin": 16.75,
   "texto": "Ah, claro, ¿me dice su pedido?"
  },
  {
   "inicio": 17.95,
   "fin": 22.11,
   "texto": "Ya, a ver, quiero tres lomos saltados personales"
  },
  {
   "inicio": 23.33,
   "fin": 25.67,
   "texto": "Tres lomos saltados personales"
  },
  {
   "inicio": 25.67,
   "fin": 29.13,
   "texto": "Y un ceviche clásico, el de Fuente"
  },
  {
   "inicio": 30.45,
   "fin": 34.33,
   "texto": "Eh, un ceviche clásico, Fuente, ¿algo para tomar?"
  },
  {
   "inicio": 35.73,
   "fin": 37.85,
   "texto": "Una jarra de chicha morada"
  },
  {
   "inicio": 37.85,
   "fin": 40.17,
   "texto": "Mmm, no, espera, espera"
  },
  {
   "inicio": 40.17,
   "fin": 43.11,
   "texto": "Mi hermano me dice que él ya comió, entonces"
  },
  {
   "inicio": 43.11,
   "fin": 46.17,
   "texto": "Que solo sean dos lomos, no tres"
  },
  {
   "inicio": 46.17,
   "fin": 51.7,
   "texto": "Ok, corrijo, dos lomos saltados personales"
  },
  {
   "inicio": 51.7,
   "fin": 55.58,
   "texto": "Un ceviche clásico, Fuente, y una jarra de chicha morada"
  },
  {
   "inicio": 56.5,
   "fin": 58.9,
   "texto": "Eso, eh, ¿cuánto está el lomo?"
  },
  {
   "inicio": 60.5,
   "fin": 63.38,
   "texto": "El lomo personal está treinta y dos soles"
  },
  {
   "inicio": 63.38,
   "fin": 65.6,
   "texto": "El ceviche, Fuente, cincuenta y dos"
  },
  {
   "inicio": 65.6,
   "fin": 67.88,
   "texto": "Y la jarra de chicha, dieciséis"
  },
  {
   "inicio": 69.06,
   "fin": 71.86,
   "texto": "Ok, eh, ¿tienen alguna promoción hoy?"
  },
  {
   "inicio": 72.98,
   "fin": 77.38,
   "texto": "Sí, tenemos un descuento de diez soles en pedidos desde cien soles"
  },
  {
   "inicio": 77.38,
   "fin": 78.94,
   "texto": "Así que, le aplica"
  },
  {
   "inicio": 79.94,
   "fin": 81.1,
   "texto": "Ah, buenísimo"
  },
  {
   "inicio": 82.12,
   "fin": 84.2,
   "texto": "¿A qué dirección se le enviamos?"
  },
  {
   "inicio": 86.28,
   "fin": 91.94,
   "texto": "Hironguamachuco, mil cuatrocientos cincuenta, departamento trescientos dos, en Jesús María"
  },
  {
   "inicio": 91.94,
   "fin": 95.44,
   "texto": "Es un edificio crema frente a una farmacia"
  },
  {
   "inicio": 97.94,
   "fin": 103.56,
   "texto": "Hironguamachuco, mil cuatrocientos cincuenta, departamento trescientos dos, Jesús María"
  },
  {
   "inicio": 103.56,
   "fin": 105.22,
   "texto": "¿Un número de contacto?"
  },
  {
   "inicio": 106.68,
   "fin": 111.36,
   "texto": "Nueve, ocho, siete, seis, cinco, cuatro, tres, dos, uno"
  },
  {
   "inicio": 113.32,
   "fin": 114.88,
   "texto": "Perfecto, ¿y cómo va a pagar?"
  },
  {
   "inicio": 115.88,
   "fin": 116.72,
   "texto": "Un yape"
  },
  {
   "inicio": 118.56,
   "fin": 124.8,
   "texto": "Perfecto, entonces su total con el descuento sería de cincuenta, ciento doce soles"
  },
  {
   "inicio": 126.08,
   "fin": 127.76,
   "texto": "Eh, ciento doce, ok"
  },
  {
   "inicio": 127.76,
   "fin": 130.38,
   "texto": "Te yapeo cuando llegue el motorizado"
  },
  {
   "inicio": 131.74,
   "fin": 135.08,
   "texto": "Listo, su pedido llega en unos cuarenta minutos"
  },
  {
   "inicio": 135.08,
   "fin": 136.84,
   "texto": "Gracias por llamar a la ola"
  },
  {
   "inicio": 139.34,
   "fin": 141.6,
   "texto": "Gracias, hasta luego"
  },
  {
   "inicio": 141.6,
   "fin": 141.64,
   "texto": "¡Gracias!"
  },
  {
   "inicio": 142.58,
   "fin": 142.78,
   "texto": "¡Gracias!"
  },
  {
