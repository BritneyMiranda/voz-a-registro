 "segmentos": [
  {
   "inicio": 0.18,
   "fin": 2.82,
   "texto": "Hola, buenas tardes. Habla milagros."
  },
  {
   "inicio": 3.88,
   "fin": 9.08,
   "texto": "Hola, buenas tardes, señorita. Para hacer un pedido, por favor. Es para una reunión familiar."
  },
  {
   "inicio": 10.58,
   "fin": 11.94,
   "texto": "Encantada. ¿Qué le anoto?"
  },
  {
   "inicio": 13.16,
   "fin": 15.34,
   "texto": "Doce biches clásicos de fuente."
  },
  {
   "inicio": 16.76,
   "fin": 23.18,
   "texto": "Doce biches clásicos fuente. Le comento que con dos fuentes la jarra de chicha morada les sale gratis."
  },
  {
   "inicio": 24.3,
   "fin": 30.68,
   "texto": "Ah, qué bien. Entonces sí, una jarra de chicha. Y aparte dos intacolas de litro y medio."
  },
  {
   "inicio": 32.32,
   "fin": 35.58,
   "texto": "Una jarra de chicha morada y dos intacolas."
  },
  {
   "inicio": 37.14,
   "fin": 40.92,
   "texto": "Y un lomo saltado personal para mi papá, que no come pescado."
  },
  {
   "inicio": 42.26,
   "fin": 44.48,
   "texto": "¿Un lomo saltado personal?"
  },
  {
   "inicio": 45.8,
   "fin": 52.84,
   "texto": "Para, eh, pensándolo bien, quitéle las intacolas. Con la chicha alcanza, y mamá no quiere asusa."
  },
  {
   "inicio": 54.44,
   "fin": 62.76,
   "texto": "Listo, le quita las dos intacolas. Entonces, doce biches fuente, una jarra de chicha morada y un lomo saltado personal."
  },
  {
   "inicio": 63.84,
   "fin": 65.92,
   "texto": "Sí, eh, me dicen los precios."
  },
  {
   "inicio": 67.16,
   "fin": 73.98,
   "texto": "Cada ceviche fuente está 52, la jarra 16 y el lomo personal 32."
  },
  {
   "inicio": 74.98,
   "fin": 78.24,
   "texto": "Ok, es para caraballo. Llega hasta allá."
  },
  {
   "inicio": 80.16,
   "fin": 82.26,
   "texto": "Sí, me da la dirección exacta."
  },
  {
   "inicio": 83.3,
   "fin": 90.96,
   "texto": "Sí, eh, manzana F, lote 12, urbanización San Antonio en caraballo, al costado de La Losa Deportiva."
  },
  {
   "inicio": 92.32,
   "fin": 99.26,
   "texto": "Manzana F, lote 12, urbanización San Antonio, caraballo. ¿Cómo va a pagar?"
  },
  {
   "inicio": 100.24,
   "fin": 100.76,
   "texto": "Por plín."
  },
  {
   "inicio": 102.48,
   "fin": 105.98,
   "texto": "Perfecto, su total es 152 soles."
  },
  {
   "inicio": 107.42,
   "fin": 110.74,
   "texto": "152, ya, eh, le pagamos cuando llegue."
  },
  {
   "inicio": 113.51,
   "fin": 117.57,
   "texto": "Por la distancia demora más o menos una hora. Gracias por llamar."
  },
  {
   "inicio": 118.63,
   "fin": 119.95,
   "texto": "Gracias, señorita."
  }
