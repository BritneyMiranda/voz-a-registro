 "segmentos": [
  {
   "inicio": 0.18,
   "fin": 2.82,
   "texto": "Hola, hola, buenas tardes. Habla Milagros."
  },
  {
   "inicio": 4.2,
   "fin": 9.08,
   "texto": "Hola, buenas tardes, señorita. Para hacer un pedido, por favor, es para una reunión familiar."
  },
  {
   "inicio": 10.6,
   "fin": 11.96,
   "texto": "Encantada. ¿Qué le anoto?"
  },
  {
   "inicio": 12.9,
   "fin": 15.34,
   "texto": "12 biches clásicos de fuente."
  },
  {
   "inicio": 16.6,
   "fin": 23.14,
   "texto": "12 biches clásicos fuente. Le comento que con dos fuentes la jarra de chicha morada le sale gratis."
  },
  {
   "inicio": 24.3,
   "fin": 30.72,
   "texto": "Ah, qué bien. Entonces sí, una jarra de chicha. Y aparte, dos inca colas del litro y medio."
  },
  {
   "inicio": 32.02,
   "fin": 35.78,
   "texto": "Una jarra de chicha morada y dos inca colas."
  },
  {
   "inicio": 36.76,
   "fin": 40.96,
   "texto": "Y un lomo saltado personal para mi papá, que no come pescado."
  },
  {
   "inicio": 42.3,
   "fin": 44.46,
   "texto": "¿Un lomo saltado personal?"
  },
  {
   "inicio": 46.34,
   "fin": 52.9,
   "texto": "Para, pensándolo bien, quítale las inca colas. Con la chicha alcanza y mi mamá no quiere gaseosa."
  },
  {
   "inicio": 54.4,
   "fin": 62.74,
   "texto": "Listo, le quito las dos inca colas. Entonces, 12 biches fuente, una jarra de chicha morada y un lomo saltado personal."
  },
  {
   "inicio": 63.86,
   "fin": 65.92,
   "texto": "Sí, ¿me dices los precios?"
  },
  {
   "inicio": 67.32,
   "fin": 73.88,
   "texto": "Cada ceviche fuente está 52, la jarra 16 y el lomo personal 32."
  },
  {
   "inicio": 75.08,
   "fin": 78.14,
   "texto": "Ok, es para Caraballo. Llega hasta allá."
  },
  {
   "inicio": 79.98,
   "fin": 82.16,
   "texto": "Sí, ¿me da la dirección exacta?"
  },
  {
   "inicio": 82.16,
   "fin": 91.0,
   "texto": "Sí, manzana F, lote 12, urbanización San Antonio en Caraballo, al costado de la losa deportiva."
  },
  {
   "inicio": 92.24,
   "fin": 99.3,
   "texto": "Manzana F, lote 12, urbanización San Antonio, Caraballo. ¿Cómo va a pagar?"
  },
  {
   "inicio": 99.94,
   "fin": 100.72,
   "texto": "Por Plin."
  },
  {
   "inicio": 102.44,
   "fin": 105.98,
   "texto": "Perfecto, su total es 152 soles."
  },
  {
   "inicio": 107.34,
   "fin": 110.72,
   "texto": "152. Ya, le pagamos cuando llegue."
  },
  {
   "inicio": 113.34,
   "fin": 117.62,
   "texto": "Por la distancia demora más o menos una hora. Gracias por llamar."
  },
  {
   "inicio": 118.76,
   "fin": 119.96,
   "texto": "Gracias, señorita."
  }
